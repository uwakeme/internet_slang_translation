/* 城市夜游 · 全局设计系统 */
page {
  background:
    radial-gradient(circle at 92% 3%, rgba(255, 122, 89, 0.18), transparent 32%),
    radial-gradient(circle at 0% 46%, rgba(77, 137, 255, 0.13), transparent 34%),
    #101a2b;
  color: #fff8ed;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

page, view, text, button, input, textarea {
  box-sizing: border-box;
}

.container {
  min-height: 100vh;
  position: relative;
  overflow-wrap: anywhere;
}

.safe-bottom { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }

.page-header {
  position: relative;
  padding: 64rpx 40rpx 44rpx;
  z-index: 1;
}

.page-title {
  display: block;
  font-size: 52rpx;
  line-height: 1.18;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: #fff8ed;
}

.page-subtitle {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #9ca9bd;
}

.card, .list-item {
  margin: 0 40rpx 24rpx;
  padding: 32rpx;
  border: 1rpx solid #2b3a52;
  border-radius: 8rpx 28rpx 28rpx 28rpx;
  background: #1a2940;
  box-shadow: 0 12rpx 30rpx rgba(3, 9, 19, 0.2);
}

.btn, .translate-btn, .load-more-btn, .retry-btn, .back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 88rpx;
  margin: 24rpx 0;
  padding: 20rpx 32rpx;
  border: 1rpx solid transparent;
  border-radius: 24rpx;
  background: #ff7a59;
  color: #172235;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 22rpx rgba(255, 122, 89, 0.2);
  transition: transform .2s ease, opacity .2s ease, background .2s ease;
}

.btn:active, .translate-btn:active, .load-more-btn:active, .retry-btn:active, .back-btn:active { transform: scale(.97); background: #ff9276; }
.btn::after, .translate-btn::after, .load-more-btn::after, .retry-btn::after, .back-btn::after { border: none; }
.btn[disabled], .translate-btn[disabled] { opacity: .45; }
.btn-secondary, .btn-white, .load-more-btn, .retry-btn, .back-btn {
  background: #223451;
  border-color: #3b4e6b;
  color: #b9d6ff;
  box-shadow: none;
}

.input-area {
  border: 1rpx solid #3b4e6b;
  border-radius: 20rpx;
  padding: 24rpx;
  background: #152238;
  color: #fff8ed;
  font-size: 28rpx;
  transition: border-color .2s ease, box-shadow .2s ease;
}
.input-area-focus { border-color: #7db7ff; box-shadow: 0 0 0 6rpx rgba(125, 183, 255, .1); }

.tag, .tag-light, .tag-active {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border: 1rpx solid #405573;
  border-radius: 999rpx;
  background: #223451;
  color: #b9d6ff;
  font-size: 24rpx;
}
.tag { background: rgba(255, 122, 89, .12); border-color: rgba(255, 122, 89, .38); color: #ff9a7a; }
.tag-active { background: #ff7a59; border-color: #ff7a59; color: #172235; font-weight: 700; }

.title-large { font-size: 36rpx; font-weight: 700; color: #fff8ed; }
.text-primary { color: #fff8ed; font-size: 28rpx; line-height: 1.6; }
.text-secondary { color: #9ca9bd; font-size: 24rpx; line-height: 1.5; }
.text-hint, .text-hint { color: #9ca9bd; font-size: 22rpx; }
.text-success { color: #8ee0b0; }

.example-box, .example-content {
  margin: 20rpx 0;
  padding: 24rpx;
  border: 1rpx solid #3b4e6b;
  border-radius: 8rpx 22rpx 22rpx 22rpx;
  background: #152238;
}
.example-text { color: #d9e2ee; font-size: 28rpx; line-height: 1.65; }
.example-label { display: flex; align-items: center; margin-bottom: 16rpx; }
.label-icon { margin-right: 10rpx; color: #7db7ff; }
.label-text { color: #9ca9bd; font-size: 24rpx; }
.divider { height: 1rpx; margin: 24rpx 0; background: #2b3a52; }

.scenario-item {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #3b4e6b;
  border-radius: 24rpx;
  background: #152238;
}
.scenario-tag { display: inline-block; padding: 8rpx 20rpx; border-radius: 999rpx; background: #7db7ff; color: #172235; font-size: 24rpx; font-weight: 700; }
.scenario-original, .scenario-translation { display: block; font-size: 28rpx; line-height: 1.6; }
.scenario-original { color: #fff8ed; }
.scenario-translation { color: #ff9a7a; font-weight: 600; }
.scenario-arrow, .scenario-arrow { color: #9ca9bd; font-size: 24rpx; text-align: center; margin: 14rpx 0; }

.empty-state, .error-state { padding: 120rpx 40rpx; text-align: center; }
.empty-text, .error-text { display: block; margin-bottom: 24rpx; color: #9ca9bd; font-size: 28rpx; }
.error-actions { display: flex; justify-content: center; gap: 20rpx; }
.error-actions .retry-btn, .error-actions .back-btn { margin-top: 0; }
.loading { padding: 48rpx; text-align: center; color: #9ca9bd; font-size: 24rpx; }

.gradient-text { color: #ff9a7a; font-weight: 700; }
.icon { color: #7db7ff; margin-right: 12rpx; }
.icon-small { color: #7db7ff; margin-right: 8rpx; font-size: 24rpx; }
.flex-row { display: flex; align-items: center; }
.flex-column { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; min-width: 0; }
.mt-small { margin-top: 16rpx; } .mt-medium { margin-top: 24rpx; } .mt-large { margin-top: 48rpx; }
.mb-small { margin-bottom: 16rpx; } .mb-medium { margin-bottom: 24rpx; } .mb-large { margin-bottom: 48rpx; }
.p-small { padding: 16rpx; } .p-medium { padding: 24rpx; } .p-large { padding: 32rpx; }

@keyframes cityIn { from { opacity: 0; transform: translateY(24rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes cityFloat { 0%, 100% { transform: translateY(0) rotate(10deg); } 50% { transform: translateY(-8rpx) rotate(7deg); } }
.fade-in, .fade-in-up { animation: cityIn .45s cubic-bezier(.22,.61,.36,1) both; }
.delay-1 { animation-delay: .06s; } .delay-2 { animation-delay: .12s; } .delay-3 { animation-delay: .18s; }
