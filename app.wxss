/* ============================================
   全局设计系统 — 暖色深色主题
   色彩：琥珀金 #f5a623 / 珊瑚红 #ff6b6b
   ============================================ */

page {
  background: radial-gradient(ellipse at top, #181b26 0%, #0c0e14 50%, #080a10 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: #f0ece2;
}

.container {
  padding: 0 0 48rpx 0;
  min-height: 100vh;
  position: relative;
}

/* ── 页面头部 ───────────────────────────── */
.page-header {
  position: relative;
  padding: 72rpx 40rpx 48rpx;
  color: #f0ece2;
  text-align: center;
  z-index: 1;
}

.page-title {
  font-size: 52rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
  background: linear-gradient(135deg, #f5a623 0%, #ff6b6b 50%, #f5a623 100%);
  background-size: 200% 200%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  letter-spacing: 2rpx;
}

.page-subtitle {
  font-size: 28rpx;
  color: #9a9590;
  font-weight: 300;
  letter-spacing: 2rpx;
}

/* ── 玻璃拟态卡片 ───────────────────────── */
.card {
  background: linear-gradient(180deg, rgba(32, 35, 48, 0.95) 0%, rgba(20, 22, 30, 0.95) 100%);
  backdrop-filter: blur(32rpx);
  -webkit-backdrop-filter: blur(32rpx);
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 40rpx 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.45), inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  position: relative;
  overflow: hidden;
  transition: all 0.25s ease;
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.15), transparent);
}

.card:active {
  transform: scale(0.97);
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.5), inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

/* ── 琥珀光晕按钮 ───────────────────────── */
.btn {
  background: linear-gradient(135deg, #f5a623 0%, #ff6b6b 100%);
  color: #fff;
  border-radius: 24rpx;
  padding: 26rpx 40rpx;
  margin: 20rpx 0;
  border: none;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 32rpx rgba(245, 166, 35, 0.35), inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
  transition: all 0.25s ease;
  position: relative;
  overflow: hidden;
}

.btn::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s ease;
}

.btn:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(245, 166, 35, 0.5), inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
}

.btn-secondary {
  background: linear-gradient(135deg, #ff6b6b 0%, #f5a623 100%);
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 107, 0.3), inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
}

.btn-secondary:active {
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.45), inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
}

.btn-white {
  background: rgba(255, 255, 255, 0.06);
  color: #f5a623;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(245, 166, 35, 0.25);
}

.btn-disabled,
.btn[disabled] {
  opacity: 0.4;
  pointer-events: none;
}

/* ── 输入框 ─────────────────────────────── */
.input-area {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-bottom: 2rpx solid rgba(245, 166, 35, 0.25);
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #f0ece2;
  transition: all 0.3s ease;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.input-area-focus {
  border-color: rgba(245, 166, 35, 0.5);
  border-bottom-color: #f5a623;
  background: rgba(245, 166, 35, 0.04);
  box-shadow: 0 0 24rpx rgba(245, 166, 35, 0.08), inset 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

/* ── 标签 ───────────────────────────────── */
.tag {
  background: rgba(245, 166, 35, 0.08);
  color: #f5a623;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
  border: 1rpx solid rgba(245, 166, 35, 0.25);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.tag-light {
  background: rgba(255, 255, 255, 0.04);
  color: #9a9590;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
}

.tag-active {
  background: rgba(245, 166, 35, 0.15);
  border-color: rgba(245, 166, 35, 0.5);
  color: #f5a623;
  box-shadow: 0 0 16rpx rgba(245, 166, 35, 0.1), inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
}

/* ── 文字层级 ───────────────────────────── */
.title-large {
  font-size: 36rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #f5a623, #ff6b6b);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.text-primary {
  color: #f0ece2;
  font-size: 28rpx;
  line-height: 1.6;
}

.text-secondary {
  color: #9a9590;
  font-size: 24rpx;
  line-height: 1.4;
}

.text-hint {
  color: #5c5855;
  font-size: 22rpx;
}

.text-success {
  color: #4ecdc4;
}

/* ── 示例框 ─────────────────────────────── */
.example-box {
  background: rgba(245, 166, 35, 0.05);
  padding: 20rpx;
  border-radius: 16rpx;
  border-left: 4rpx solid #f5a623;
  margin: 16rpx 0;
}

.example-text {
  font-size: 28rpx;
  color: #9a9590;
  line-height: 1.6;
}

.word-example {
  margin-top: 24rpx;
}

.example-label {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.label-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
  color: #f5a623;
}

.label-text {
  font-size: 24rpx;
  color: #5c5855;
  font-weight: 500;
}

.example-content {
  background: rgba(20, 22, 30, 0.7);
  padding: 24rpx;
  border-radius: 16rpx;
  border-left: 4rpx solid #f5a623;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.25);
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  border-right: 1rpx solid rgba(255, 255, 255, 0.06);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.example-content .example-text {
  font-size: 28rpx;
  color: #9a9590;
  line-height: 1.6;
}

/* ── 场景应用 ───────────────────────────── */
.scenarios-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.scenario-item {
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 32rpx;
  background: rgba(20, 22, 30, 0.7);
  margin-bottom: 24rpx;
  transition: all 0.25s ease;
}

.scenario-item:active {
  border-color: rgba(245, 166, 35, 0.4);
  box-shadow: 0 0 0 4rpx rgba(245, 166, 35, 0.08);
}

.scenario-header {
  margin-bottom: 24rpx;
  text-align: center;
}

.scenario-tag {
  background: linear-gradient(135deg, #f5a623, #ff6b6b);
  color: #fff;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(245, 166, 35, 0.3);
}

.scenario-content {
  text-align: center;
}

.scenario-original {
  display: block;
  font-size: 28rpx;
  color: #f0ece2;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.scenario-arrow {
  font-size: 24rpx;
  color: #5c5855;
  margin-bottom: 16rpx;
}

.scenario-translation {
  display: block;
  font-size: 28rpx;
  color: #f5a623;
  font-weight: 600;
  line-height: 1.5;
}

/* ── 列表项 ─────────────────────────────── */
.list-item {
  background: rgba(20, 22, 30, 0.95);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border-radius: 20rpx;
  padding: 32rpx;
  margin: 0 40rpx 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.35);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  position: relative;
  overflow: hidden;
  transition: all 0.25s ease;
}

.list-item:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.45);
}

/* ── 空状态 ─────────────────────────────── */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: rgba(240, 236, 226, 0.7);
}

.empty-text {
  font-size: 28rpx;
  color: #9a9590;
}

/* ── 加载状态 ───────────────────────────── */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #9a9590;
  font-size: 24rpx;
}

/* ── 分割线 ─────────────────────────────── */
.divider {
  height: 1rpx;
  background: rgba(245, 166, 35, 0.1);
  margin: 20rpx 0;
}

/* ── 图标 ───────────────────────────────── */
.icon {
  font-size: 32rpx;
  color: #f5a623;
  margin-right: 16rpx;
}

.icon-small {
  font-size: 24rpx;
  margin-right: 8rpx;
}

/* ── 渐变文字 ───────────────────────────── */
.gradient-text {
  background: linear-gradient(135deg, #f5a623, #ff6b6b);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  font-weight: 600;
}

/* ── 阴影 ───────────────────────────────── */
.shadow-light {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.25);
}

.shadow-medium {
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.35);
}

.shadow-heavy {
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.45);
}

/* ── 动画 ───────────────────────────────── */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.fade-in {
  animation: fadeIn 0.35s ease-out;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

.rotate {
  animation: rotate 20s linear infinite;
}

/* ── 布局 ───────────────────────────────── */
.flex-row {
  display: flex;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-1 {
  flex: 1;
}

/* ── 间距 ───────────────────────────────── */
.mt-small  { margin-top: 16rpx; }
.mt-medium { margin-top: 24rpx; }
.mt-large  { margin-top: 48rpx; }

.mb-small  { margin-bottom: 16rpx; }
.mb-medium { margin-bottom: 24rpx; }
.mb-large  { margin-bottom: 48rpx; }

.p-small { padding: 16rpx; }
.p-medium { padding: 24rpx; }
.p-large { padding: 32rpx; }
