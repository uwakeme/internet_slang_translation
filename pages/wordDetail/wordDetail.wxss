.container { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.word-header { position: relative; padding: 64rpx 40rpx 44rpx; overflow: hidden; text-align: center; }
.detail-orbit { position: absolute; top: -150rpx; right: -130rpx; width: 360rpx; height: 360rpx; border: 1rpx solid rgba(125,183,255,.18); border-radius: 50%; }
.detail-sticker { position: absolute; top: 60rpx; right: 36rpx; width: 92rpx; height: 92rpx; display: flex; align-items: center; justify-content: center; border: 4rpx solid #101a2b; border-radius: 50%; background: #7db7ff; box-shadow: 5rpx 6rpx 0 #ff7a59; color: #172235; font-size: 20rpx; font-weight: 800; line-height: 1.2; transform: rotate(10deg); }
.word-eyebrow { display: block; margin-bottom: 14rpx; color: #7db7ff; font-size: 19rpx; letter-spacing: 4rpx; }
.word-name { display: block; color: #fff8ed; font-size: 66rpx; font-weight: 800; line-height: 1.2; letter-spacing: 1rpx; overflow-wrap: anywhere; }
.word-meta { position: relative; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 16rpx; margin: 26rpx 0; }
.copy-btn { min-height: 64rpx; margin: 0; padding: 10rpx 20rpx; border: 1rpx solid #405573; border-radius: 18rpx; background: #223451; color: #b9d6ff; font-size: 22rpx; line-height: 1.4; }
.copy-btn::after { border: none; }
.fav-btn-active { border-color: #ff7a59 !important; background: rgba(255,122,89,.15) !important; color: #ff9a7a !important; }
.word-category-label { color: #9ca9bd; font-size: 23rpx; }
.word-tags { position: relative; display: flex; flex-wrap: wrap; justify-content: center; gap: 12rpx; }
.word-tag { padding: 7rpx 16rpx; border: 1rpx solid rgba(255,122,89,.3); border-radius: 999rpx; background: rgba(255,122,89,.08); color: #ff9a7a; font-size: 22rpx; }
.section { position: relative; margin: 0 40rpx 28rpx; padding: 30rpx; overflow: hidden; border: 1rpx solid #2b3a52; border-radius: 8rpx 28rpx 28rpx 28rpx; background: #1a2940; }
.section-header { display: flex; align-items: center; margin-bottom: 24rpx; padding-bottom: 18rpx; border-bottom: 1rpx solid #2b3a52; }
.section-icon { margin-right: 12rpx; font-size: 28rpx; }
.section-title { font-size: 30rpx; font-weight: 800; }
.translation-section { border-left: 5rpx solid #ff7a59; }
.translation-content { padding: 26rpx; border-radius: 20rpx 20rpx 6rpx 20rpx; background: rgba(255,122,89,.1); text-align: center; }
.translation-text { color: #fff8ed; font-size: 36rpx; font-weight: 700; line-height: 1.55; }
.example-section { border-left: 5rpx solid #7db7ff; }
.example-content { padding: 24rpx; border-color: #3b4e6b; background: #152238; }
.example-content .example-text { color: #d9e2ee; font-size: 27rpx; line-height: 1.65; }
.scenarios-section { border-left: 5rpx solid #8ee0b0; }
.scenarios-list { display: flex; flex-direction: column; gap: 24rpx; }
.scenario-item { padding: 24rpx; border: 1rpx solid #3b4e6b; border-radius: 20rpx; background: #152238; }
.scenario-header { margin-bottom: 20rpx; }
.scenario-tag { display: inline-block; padding: 7rpx 18rpx; border-radius: 999rpx; background: #8ee0b0; color: #172235; font-size: 23rpx; font-weight: 700; }
.dialogue-container, .paragraph-container { display: flex; flex-direction: column; gap: 18rpx; }
.dialogue-item { display: flex; flex-direction: column; align-items: flex-start; }
.dialogue-item.translated { align-items: flex-end; }
.speaker-tag { margin-bottom: 10rpx; padding: 5rpx 14rpx; border-radius: 12rpx; background: #263854; color: #9ca9bd; font-size: 20rpx; }
.speaker-tag.translation-tag { background: rgba(255,122,89,.15); color: #ff9a7a; }
.dialogue-bubble { max-width: 84%; padding: 20rpx 24rpx; font-size: 27rpx; line-height: 1.55; }
.original-bubble { border: 1rpx solid #3b4e6b; border-radius: 22rpx 22rpx 22rpx 6rpx; background: #263854; color: #fff8ed; }
.translated-bubble { border: 1rpx solid rgba(255,122,89,.3); border-radius: 22rpx 22rpx 6rpx 22rpx; background: rgba(255,122,89,.1); color: #fff8ed; }
.dialogue-arrow, .paragraph-arrow { color: #7db7ff; font-size: 22rpx; text-align: center; }
.paragraph-item { padding: 22rpx; border-radius: 18rpx; }
.original-paragraph { border: 1rpx solid #3b4e6b; background: #263854; }
.translated-paragraph { border: 1rpx solid rgba(255,122,89,.3); background: rgba(255,122,89,.08); }
.paragraph-label { margin-bottom: 10rpx; color: #9ca9bd; font-size: 22rpx; }
.paragraph-text { color: #fff8ed; font-size: 27rpx; line-height: 1.65; }
.related-list { display: flex; flex-direction: column; gap: 14rpx; }
.related-item { display: flex; align-items: center; gap: 16rpx; min-height: 64rpx; padding: 20rpx; border: 1rpx solid #2b3a52; border-radius: 18rpx; background: #172438; }
.related-item-hover { background: #223451; }
.related-word { flex-shrink: 0; max-width: 45%; color: #fff8ed; font-size: 27rpx; font-weight: 700; overflow-wrap: anywhere; }
.related-meaning { flex: 1; overflow: hidden; color: #9ca9bd; font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.related-arrow { color: #7db7ff; font-size: 30rpx; }
