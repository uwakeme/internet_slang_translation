/* ========== 词语详情页 - 精致暖色深色主题 ========== */

.container {
  min-height: 100vh;
  padding: 0 0 48rpx 0;
  position: relative;
}

/* 词汇标题区域 */
.word-header {
  padding: 72rpx 40rpx 48rpx;
  text-align: center;
  color: #f0ece2;
  position: relative;
  z-index: 1;
}

.word-name-wrap {
  margin-bottom: 20rpx;
}

.word-name {
  font-size: 64rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #f5a623, #ff6b6b);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  letter-spacing: 4rpx;
}

.word-meta {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.copy-btn {
  background: rgba(245, 166, 35, 0.08);
  color: #f5a623;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(245, 166, 35, 0.3);
  line-height: 1.5;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
  transition: all 0.25s ease;
}

.copy-btn:active {
  transform: scale(0.95);
  background: rgba(245, 166, 35, 0.15);
}

.word-category-label {
  font-size: 26rpx;
  color: #9a9590;
  font-weight: 300;
}

.word-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
}

.word-tag {
  background: rgba(245, 166, 35, 0.06);
  color: #f5a623;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
  border: 1rpx solid rgba(245, 166, 35, 0.3);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
}

/* 通用区块卡片 */
.section {
  margin: 0 40rpx 32rpx;
  background: linear-gradient(180deg, rgba(38, 41, 54, 0.95) 0%, rgba(22, 24, 32, 0.95) 100%);
  backdrop-filter: blur(32rpx);
  -webkit-backdrop-filter: blur(32rpx);
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.4), inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
  position: relative;
  overflow: hidden;
}

.section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.18), transparent);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.section-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #f0ece2;
}

/* 翻译区 - 琥珀金左边线 */
.translation-section {
  border-left: 4rpx solid #f5a623;
}

.translation-content {
  text-align: center;
  padding: 28rpx;
  background: rgba(245, 166, 35, 0.06);
  border-radius: 16rpx;
  border: 1rpx solid rgba(245, 166, 35, 0.15);
}

.translation-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #f0ece2;
  line-height: 1.5;
}

/* 示例区 - 珊瑚红左边线 */
.example-section {
  border-left: 4rpx solid #ff6b6b;
}

.example-content {
  background: rgba(255, 107, 107, 0.05);
  padding: 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 107, 107, 0.12);
}

.example-content .example-text {
  font-size: 28rpx;
  color: #9a9590;
  line-height: 1.6;
}

/* 场景区 - 薄荷绿左边线 */
.scenarios-section {
  border-left: 4rpx solid #4ecdc4;
}

/* 场景列表 */
.scenarios-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.scenario-item {
  display: flex;
  flex-direction: column;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 20rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.scenario-header {
  margin-bottom: 20rpx;
}

.scenario-tag {
  font-size: 26rpx;
  font-weight: 600;
  color: #a78bfa;
  background: rgba(167, 139, 250, 0.08);
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(167, 139, 250, 0.25);
  display: inline-block;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
}

/* 对话形式 */
.dialogue-container {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.dialogue-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.dialogue-item.translated {
  align-items: flex-end;
}

.speaker-tag {
  font-size: 22rpx;
  color: #9a9590;
  background: rgba(255, 255, 255, 0.06);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.speaker-tag.translation-tag {
  color: #4ecdc4;
  background: rgba(78, 205, 196, 0.08);
  border-color: rgba(78, 205, 196, 0.25);
}

.dialogue-bubble {
  max-width: 80%;
  padding: 22rpx 26rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
  position: relative;
}

.dialogue-bubble.original-bubble {
  background: rgba(255, 255, 255, 0.06);
  color: #f0ece2;
  border-bottom-left-radius: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.dialogue-bubble.translated-bubble {
  background: rgba(78, 205, 196, 0.08);
  color: #4ecdc4;
  border-bottom-right-radius: 8rpx;
  border: 1rpx solid rgba(78, 205, 196, 0.15);
}

.dialogue-arrow {
  text-align: center;
  font-size: 24rpx;
  color: #5c5855;
  margin: 16rpx 0;
  font-weight: 500;
}

/* 段落形式 */
.paragraph-container {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.paragraph-item {
  padding: 24rpx;
  border-radius: 16rpx;
}

.original-paragraph {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-left: 4rpx solid #9a9590;
}

.translated-paragraph {
  background: rgba(78, 205, 196, 0.05);
  border: 1rpx solid rgba(78, 205, 196, 0.1);
  border-left: 4rpx solid #4ecdc4;
}

.paragraph-label {
  font-size: 24rpx;
  color: #5c5855;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.paragraph-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #f0ece2;
}

.paragraph-arrow {
  text-align: center;
  font-size: 24rpx;
  color: #5c5855;
  margin: 12rpx 0;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #9a9590;
}
