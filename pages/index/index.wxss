.city-home { padding: 28rpx 0 64rpx; }
.hero { position: relative; padding: 32rpx 40rpx 36rpx; overflow: hidden; }
.hero-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 54rpx; }
.brand-row { display: flex; align-items: center; }
.brand-dot { width: 16rpx; height: 16rpx; margin-right: 14rpx; border-radius: 50%; background: #ff7a59; box-shadow: 0 0 18rpx rgba(255,122,89,.8); }
.brand-name { font-size: 28rpx; font-weight: 700; letter-spacing: 2rpx; }
.online-label { padding: 7rpx 16rpx; border: 1rpx solid #3b4e6b; border-radius: 999rpx; color: #9ca9bd; font-size: 20rpx; }
.eyebrow { display: block; margin-bottom: 20rpx; color: #7db7ff; font-size: 20rpx; font-weight: 600; letter-spacing: 4rpx; }
.hero-title text { display: block; font-size: 72rpx; line-height: 1.12; font-weight: 800; letter-spacing: -2rpx; }
.hero-title .accent-line { color: #ff8b68; }
.hero-subtitle { display: block; width: 88%; margin-top: 28rpx; color: #9ca9bd; font-size: 26rpx; line-height: 1.75; }
.night-sticker { position: absolute; z-index: 2; top: 122rpx; right: 28rpx; width: 108rpx; height: 108rpx; display: flex; align-items: center; justify-content: center; border: 5rpx solid #101a2b; border-radius: 50%; background: #7db7ff; box-shadow: 7rpx 8rpx 0 #ff7a59; color: #172235; font-size: 22rpx; font-weight: 800; line-height: 1.25; text-align: center; transform: rotate(11deg); animation: cityFloat 5s ease-in-out infinite; }
.orbit { position: absolute; border: 1rpx solid rgba(125,183,255,.2); border-radius: 50%; pointer-events: none; }
.orbit-one { width: 420rpx; height: 420rpx; top: -80rpx; right: -220rpx; }
.orbit-two { width: 250rpx; height: 250rpx; top: -8rpx; right: -140rpx; border-color: rgba(255,122,89,.25); }
.home-search { display: flex; align-items: center; margin: 0 40rpx 48rpx; padding: 18rpx 20rpx 18rpx 28rpx; border: 1rpx solid #3b4e6b; border-radius: 28rpx; background: #1a2940; box-shadow: 0 10rpx 26rpx rgba(3,9,19,.22); transition: transform .2s ease, border-color .2s ease; }
.home-search-active { transform: scale(.98); border-color: #ff7a59; }
.search-glyph { width: 46rpx; color: #7db7ff; font-size: 52rpx; line-height: 1; transform: rotate(-15deg); }
.search-placeholder { flex: 1; color: #9ca9bd; font-size: 28rpx; }
.search-go { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; background: #ff7a59; color: #172235; font-size: 36rpx; font-weight: 700; }
.section { margin-bottom: 52rpx; }
.section-heading { display: flex; align-items: center; justify-content: space-between; margin: 0 40rpx 26rpx; }
.heading-left { display: flex; align-items: center; }
.heading-mark { margin-right: 12rpx; color: #ff8b68; font-size: 32rpx; }
.section-kicker { font-size: 34rpx; font-weight: 800; }
.section-note { color: #9ca9bd; font-size: 20rpx; letter-spacing: 2rpx; }
.decode-card { position: relative; margin: 0 40rpx; padding: 28rpx; overflow: hidden; border: 1rpx solid #3b4e6b; border-radius: 8rpx 34rpx 34rpx 34rpx; background: #1a2940; box-shadow: 0 16rpx 36rpx rgba(3,9,19,.24); }
.decode-source { padding: 24rpx; border-radius: 20rpx 20rpx 20rpx 6rpx; background: #263854; }
.mini-label { display: block; margin-bottom: 12rpx; color: #9ca9bd; font-size: 20rpx; letter-spacing: 2rpx; }
.source-text, .result-text { display: block; font-size: 30rpx; line-height: 1.6; }
.source-text { color: #edf3fb; }
.decode-line { display: flex; align-items: center; justify-content: space-between; margin: 18rpx 8rpx; color: #ff9a7a; font-size: 22rpx; }
.decode-result { padding: 24rpx; border: 1rpx solid rgba(255,122,89,.35); border-radius: 20rpx 20rpx 6rpx 20rpx; background: rgba(255,122,89,.1); }
.decode-result .result-text { color: #fff8ed; font-weight: 600; }
.decode-spark { position: absolute; top: 20rpx; right: 24rpx; color: #7db7ff; font-size: 40rpx; }
.hot-scroll { width: 100%; white-space: nowrap; }
.hot-row { display: inline-flex; gap: 20rpx; padding: 0 40rpx 8rpx; }
.hot-tag { position: relative; display: inline-flex; flex-direction: column; width: 270rpx; min-height: 210rpx; padding: 24rpx; overflow: hidden; border: 1rpx solid #3b4e6b; border-radius: 8rpx 28rpx 28rpx 28rpx; background: #1a2940; vertical-align: top; white-space: normal; transition: transform .2s ease, background .2s ease; }
.hot-tag-active { transform: translateY(-6rpx); background: #223451; }
.hot-index { color: #7db7ff; font-size: 20rpx; font-weight: 700; }
.hot-tag-word { margin: 22rpx 0 12rpx; color: #ff9a7a; font-size: 34rpx; font-weight: 800; }
.hot-tag-meaning { color: #9ca9bd; font-size: 23rpx; line-height: 1.55; }
.category-block { margin: 0 40rpx 36rpx; }
.category-title-row { display: flex; align-items: center; margin-bottom: 18rpx; transition: transform .2s ease; }
.category-title-active { transform: translateX(6rpx); }
.category-icon-box { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; margin-right: 18rpx; border-radius: 22rpx; box-shadow: 4rpx 5rpx 0 rgba(125,183,255,.3); }
.category-icon-img { width: 42rpx; height: 42rpx; }
.category-icon-text { font-size: 34rpx; }
.category-name { flex: 1; font-size: 30rpx; font-weight: 700; }
.category-arrow { color: #7db7ff; font-size: 34rpx; }
.category-words { display: flex; flex-direction: column; gap: 14rpx; }
.word-card { display: flex; align-items: center; padding: 22rpx 24rpx; border: 1rpx solid #2b3a52; border-radius: 22rpx; background: #172438; transition: transform .2s ease, border-color .2s ease; }
.word-card-active { transform: scale(.98); border-color: #ff7a59; }
.word-name { flex-shrink: 0; max-width: 45%; margin-right: 20rpx; color: #fff8ed; font-size: 28rpx; font-weight: 700; }
.word-meaning { flex: 1; overflow: hidden; color: #9ca9bd; font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }
.word-arrow { margin-left: 12rpx; color: #7db7ff; font-size: 30rpx; }
