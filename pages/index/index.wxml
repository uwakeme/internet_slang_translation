<view class="container">
  <!-- 标题区域 -->
  <view class="header fade-in">
    <text class="title">互联网黑话翻译器</text>
    <text class="subtitle">让沟通更简单</text>
  </view>

  <!-- 搜索入口 -->
  <view class="search-entry fade-in-delay1" bindtap="goToSearch">
    <text class="search-icon">🔍</text>
    <text class="search-placeholder">搜索黑话、含义或标签</text>
  </view>

  <!-- 今日热词 -->
  <view class="section fade-in-delay2">
    <view class="section-header">
      <view class="section-bar"></view>
      <text class="section-title">今日热词</text>
    </view>
    <view class="hot-words-wrap">
      <view
        class="hot-tag"
        wx:for="{{hotWords}}"
        wx:key="id"
        data-word="{{item.word}}"
        bindtap="goToWordDetail"
      >
        <text class="hot-tag-word">{{item.word}}</text>
        <text class="hot-tag-meaning">{{item.meaning}}</text>
      </view>
    </view>
  </view>

  <!-- 分类速览 -->
  <view class="section fade-in-delay3">
    <view class="section-header">
      <view class="section-bar"></view>
      <text class="section-title">分类速览</text>
    </view>
    <view
      class="category-block"
      wx:for="{{categorySections}}"
      wx:key="id"
    >
      <view
        class="category-title-row"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        bindtap="goToCategory"
      >
        <view class="category-color-dot" style="background: {{item.color}};"></view>
        <view class="category-icon-box">
          <image wx:if="{{item.iconType === 'image'}}" class="category-icon-img" src="{{item.icon}}" mode="aspectFit"/>
          <text wx:else class="category-icon-text">{{item.icon}}</text>
        </view>
        <text class="category-name">{{item.name}}</text>
        <text class="category-arrow">›</text>
      </view>
      <view class="category-words">
        <view
          class="word-card"
          wx:for="{{item.words}}"
          wx:for-item="word"
          wx:key="id"
          style="border-left-color: {{item.color}};"
          data-word="{{word.word}}"
          bindtap="goToWordDetail"
        >
          <text class="word-name">{{word.word}}</text>
          <text class="word-meaning">{{word.meaning}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
