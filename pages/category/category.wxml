<view class="container">
  <view class="page-header">
    <text class="page-title">黑话分类</text>
    <text class="page-subtitle">探索不同领域的专业术语</text>
  </view>

  <!-- 互联网黑话 -->
  <view class="section">
    <view class="section-header">
      <view class="section-indicator jargon-indicator"></view>
      <text class="section-icon">🗣️</text>
      <text class="section-title">互联网黑话</text>
      <text class="section-desc">日常沟通用语</text>
    </view>
    <view class="category-grid">
      <view 
        class="category-item jargon-item fade-in-up" 
        wx:for="{{jargonCategories}}" 
        wx:key="id"
        bindtap="goToWordList"
        data-category="{{item}}"
        style="animation-delay: {{index * 0.08}}s"
      >
        <view class="category-icon">
          <image class="category-icon-img" src="{{item.icon}}" mode="aspectFit"/>
        </view>
        <text class="category-name">{{item.name}}</text>
        <text class="category-desc">{{item.desc}}</text>
        <view class="category-count-tag">{{item.count}}个词汇</view>
      </view>
    </view>
  </view>

  <!-- 专业名词 -->
  <view class="section">
    <view class="section-header">
      <view class="section-indicator professional-indicator"></view>
      <text class="section-icon">🔧</text>
      <text class="section-title">专业名词</text>
      <text class="section-desc">技术术语</text>
    </view>
    <view class="category-grid">
      <view 
        class="category-item professional-item fade-in-up" 
        wx:for="{{professionalCategories}}" 
        wx:key="id"
        bindtap="goToWordList"
        data-category="{{item}}"
        style="animation-delay: {{index * 0.08}}s"
      >
        <view class="category-icon">
          <image class="category-icon-img" src="{{item.icon}}" mode="aspectFit"/>
        </view>
        <text class="category-name">{{item.name}}</text>
        <text class="category-desc">{{item.desc}}</text>
        <view class="category-count-tag">{{item.count}}个词汇</view>
      </view>
    </view>
  </view>
</view>
