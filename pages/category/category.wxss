.page-header { padding: 64rpx 40rpx 40rpx; }
.page-eyebrow { display: block; margin-bottom: 16rpx; color: #7db7ff; font-size: 20rpx; font-weight: 700; letter-spacing: 4rpx; }
.page-title { display: block; font-size: 56rpx; font-weight: 800; }
.page-subtitle { display: block; margin-top: 14rpx; color: #9ca9bd; font-size: 26rpx; }
.favorites-entry { display: flex; align-items: center; margin: 0 40rpx 44rpx; padding: 28rpx; border: 1rpx solid rgba(255,122,89,.35); border-radius: 8rpx 28rpx 28rpx 28rpx; background: rgba(255,122,89,.1); }
.favorites-entry-hover { background: rgba(255,122,89,.18); }
.favorites-icon { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; background: #ff7a59; font-size: 34rpx; }
.favorites-text { flex: 1; display: flex; flex-direction: column; margin-left: 20rpx; }
.favorites-title { font-size: 30rpx; font-weight: 700; }
.favorites-desc { margin-top: 4rpx; color: #9ca9bd; font-size: 22rpx; }
.favorites-arrow { color: #ff9a7a; font-size: 40rpx; }
.section { margin-bottom: 48rpx; }
.section-header { display: flex; align-items: center; margin: 0 40rpx 24rpx; }
.section-indicator { width: 8rpx; height: 38rpx; margin-right: 14rpx; border-radius: 999rpx; background: #ff7a59; }
.professional-indicator { background: #7db7ff; }
.section-icon { margin-right: 12rpx; font-size: 30rpx; }
.section-title { font-size: 34rpx; font-weight: 800; }
.section-desc { margin-left: auto; color: #9ca9bd; font-size: 22rpx; }
.category-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; padding: 0 40rpx; }
.category-item { position: relative; padding: 28rpx 22rpx; overflow: hidden; border: 1rpx solid #2b3a52; border-radius: 8rpx 26rpx 26rpx 26rpx; background: #1a2940; text-align: left; transition: transform .2s ease, border-color .2s ease; }
.category-item:nth-child(3n+2) { border-radius: 26rpx 8rpx 26rpx 26rpx; }
.category-item:active { transform: translateY(-4rpx); border-color: #ff7a59; }
.category-item::after { content: ''; position: absolute; width: 100rpx; height: 100rpx; top: -46rpx; right: -46rpx; border: 1rpx solid rgba(125,183,255,.18); border-radius: 50%; }
.category-icon { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 22rpx; border-radius: 22rpx; background: #263854; }
.professional-item .category-icon { background: rgba(125,183,255,.14); }
.category-icon-img { width: 42rpx; height: 42rpx; }
.category-icon-text { font-size: 34rpx; }
.category-name { display: block; font-size: 28rpx; font-weight: 700; }
.category-desc { display: block; min-height: 60rpx; margin: 8rpx 0 18rpx; color: #9ca9bd; font-size: 21rpx; line-height: 1.45; }
.category-count-tag { display: inline-block; padding: 5rpx 14rpx; border: 1rpx solid rgba(255,122,89,.3); border-radius: 999rpx; background: rgba(255,122,89,.08); color: #ff9a7a; font-size: 20rpx; }
.professional-item .category-count-tag { border-color: rgba(125,183,255,.3); background: rgba(125,183,255,.08); color: #9cc6ff; }
