/* ============================================
   分类页样式 — 暖色深色主题
   ============================================ */

.section {
  margin-bottom: 60rpx;
}

/* ── Section 标题区域 ───────────────────── */
.section-header {
  display: flex;
  align-items: center;
  padding: 0 40rpx 30rpx;
  margin-bottom: 30rpx;
}

.section-indicator {
  width: 6rpx;
  height: 40rpx;
  border-radius: 3rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.jargon-indicator {
  background: linear-gradient(180deg, #f5a623, #ff6b6b);
  box-shadow: 0 0 16rpx rgba(245, 166, 35, 0.35);
}

.professional-indicator {
  background: linear-gradient(180deg, #ff6b6b, #a78bfa);
  box-shadow: 0 0 16rpx rgba(255, 107, 107, 0.35);
}

.section-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #f0ece2;
  margin-right: 16rpx;
  letter-spacing: 2rpx;
}

.section-desc {
  font-size: 24rpx;
  color: #9a9590;
}

/* ── 分类网格 ───────────────────────────── */
.category-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 0 40rpx;
}

/* ── 分类卡片 ───────────────────────────── */
.category-item {
  background: linear-gradient(180deg, rgba(32, 35, 48, 0.95) 0%, rgba(20, 22, 30, 0.95) 100%);
  backdrop-filter: blur(32rpx);
  -webkit-backdrop-filter: blur(32rpx);
  border-radius: 24rpx;
  padding: 36rpx 24rpx;
  text-align: center;
  transition: all 0.25s ease;
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.4), inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.category-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.12), transparent);
}

.category-item:active {
  transform: scale(0.96);
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.45), inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

/* ── 分类图标容器 ───────────────────────── */
.category-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.4), inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.05));
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.category-icon-img {
  width: 46rpx;
  height: 46rpx;
}

/* ── 分类名称 ───────────────────────────── */
.category-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #f0ece2;
  margin-bottom: 10rpx;
  display: block;
}

/* ── 分类描述 ───────────────────────────── */
.category-desc {
  font-size: 22rpx;
  color: #9a9590;
  margin-bottom: 18rpx;
  display: block;
}

/* ── 词汇数量标签（黑话：琥珀色） ───────── */
.category-count-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #f5a623;
  border: 1rpx solid rgba(245, 166, 35, 0.25);
  border-radius: 24rpx;
  padding: 6rpx 16rpx;
  background: rgba(245, 166, 35, 0.08);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
}

/* ── 专业名词卡片标签（珊瑚红） ─────────── */
.professional-item .category-count-tag {
  color: #ff6b6b;
  border-color: rgba(255, 107, 107, 0.25);
  background: rgba(255, 107, 107, 0.08);
}

/* ── 逐项淡入动画 ───────────────────────── */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.fade-in-up {
  opacity: 0;
  animation: fadeInUp 0.5s ease-out forwards;
}
