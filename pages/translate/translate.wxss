/* ============================================
   翻译页样式 — 精致暖色深色主题
   ============================================ */

.container {
  min-height: 100vh;
  padding: 40rpx;
  position: relative;
}

/* ── 页面标题 ───────────────────────────── */
.page-title {
  text-align: center;
  margin-bottom: 48rpx;
  position: relative;
  z-index: 1;
}

.page-title text {
  font-size: 48rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #f5a623, #ff6b6b);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* ── 胶囊模式切换器 ─────────────────────── */
.translate-modes {
  display: flex;
  background: linear-gradient(180deg, rgba(38, 41, 54, 0.95) 0%, rgba(22, 24, 32, 0.95) 100%);
  backdrop-filter: blur(32rpx);
  -webkit-backdrop-filter: blur(32rpx);
  border-radius: 50rpx;
  padding: 10rpx;
  margin-bottom: 48rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.4), inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  position: relative;
  overflow: hidden;
}

.translate-modes::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.18), transparent);
}

.mode-btn {
  flex: 1;
  background: transparent;
  color: #9a9590;
  border: none;
  border-radius: 40rpx;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  position: relative;
  z-index: 1;
}

.mode-btn:active {
  transform: scale(0.97);
}

.mode-btn.active {
  background: linear-gradient(135deg, #f5a623, #ff6b6b);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 8rpx 32rpx rgba(245, 166, 35, 0.35), inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
}

/* ── 翻译区域 ───────────────────────────── */
.translate-area {
  margin-bottom: 48rpx;
}

.input-section {
  background: linear-gradient(180deg, rgba(38, 41, 54, 0.95) 0%, rgba(22, 24, 32, 0.95) 100%);
  backdrop-filter: blur(32rpx);
  -webkit-backdrop-filter: blur(32rpx);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.4), inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  position: relative;
  overflow: hidden;
}

.input-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.18), transparent);
}

.section-title {
  font-weight: 600;
  color: #f0ece2;
  font-size: 28rpx;
  display: block;
  margin-bottom: 20rpx;
}

.input-area {
  width: 100%;
  height: 200rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-bottom: 2rpx solid rgba(245, 166, 35, 0.25);
  border-radius: 16rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.04);
  box-sizing: border-box;
  font-size: 28rpx;
  color: #f0ece2;
  transition: all 0.3s ease;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.input-area-focus {
  border-color: rgba(245, 166, 35, 0.45);
  border-bottom-color: #f5a623;
  background: rgba(245, 166, 35, 0.04);
  box-shadow: 0 0 24rpx rgba(245, 166, 35, 0.08), inset 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #9a9590;
  margin-top: 12rpx;
}

/* ── 翻译按钮 ───────────────────────────── */
.translate-btn {
  width: 100%;
  background: linear-gradient(135deg, #f5a623, #ff6b6b);
  color: #fff;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  padding: 26rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 32rpx rgba(245, 166, 35, 0.35), inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
  border: none;
  transition: all 0.25s ease;
  position: relative;
  overflow: hidden;
}

.translate-btn::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s ease;
}

.translate-btn:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(245, 166, 35, 0.5), inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
}

.translate-btn[disabled] {
  opacity: 0.4;
  pointer-events: none;
}

/* ── 结果卡片 ───────────────────────────── */
.result-card {
  background: linear-gradient(180deg, rgba(38, 41, 54, 0.95) 0%, rgba(22, 24, 32, 0.95) 100%);
  backdrop-filter: blur(32rpx);
  -webkit-backdrop-filter: blur(32rpx);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.4), inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-left: 4rpx solid #4ecdc4;
  position: relative;
  overflow: hidden;
}

.result-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.18), transparent);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.section-header .section-title {
  margin-bottom: 0;
}

.result-content {
  background: rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.result-text {
  color: #f0ece2;
  line-height: 1.6;
  font-size: 30rpx;
}

.copy-btn {
  background: rgba(245, 166, 35, 0.08);
  color: #f5a623;
  border-radius: 20rpx;
  padding: 12rpx 22rpx;
  font-size: 24rpx;
  border: 1rpx solid rgba(245, 166, 35, 0.3);
  font-weight: 500;
  transition: all 0.25s ease;
}

.copy-btn:active {
  transform: scale(0.95);
  background: rgba(245, 166, 35, 0.15);
}

/* ── 淡入动画 ───────────────────────────── */
.fade-in-up {
  animation: fadeInUp 0.4s ease-out forwards;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ── 历史区域 ───────────────────────────── */
.history {
  position: relative;
  z-index: 1;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.history-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #f0ece2;
}

.clear-btn {
  background: rgba(255, 255, 255, 0.04);
  color: #9a9590;
  border-radius: 16rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  border: 1rpx solid rgba(154, 149, 144, 0.25);
  font-weight: 500;
  transition: all 0.25s ease;
}

.clear-btn:active {
  transform: scale(0.95);
  background: rgba(255, 107, 107, 0.1);
  border-color: rgba(255, 107, 107, 0.35);
  color: #ff6b6b;
}

/* ── 历史列表 ───────────────────────────── */
.history-list {
  background: linear-gradient(180deg, rgba(38, 41, 54, 0.95) 0%, rgba(22, 24, 32, 0.95) 100%);
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.4), inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
  position: relative;
}

.history-list::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.18), transparent);
}

.history-item {
  padding: 28rpx 32rpx;
  position: relative;
  transition: all 0.25s ease;
}

.history-item:not(:last-child) {
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.history-item:active {
  background: rgba(245, 166, 35, 0.04);
  transform: scale(0.98);
}

.history-content {
  margin-bottom: 12rpx;
}

.original {
  display: block;
  font-size: 28rpx;
  color: #f0ece2;
  margin-bottom: 8rpx;
  line-height: 1.5;
  font-weight: 500;
}

.arrow {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #5c5855;
  margin: 8rpx 0;
}

.translated {
  display: block;
  font-size: 28rpx;
  color: #f5a623;
  font-weight: 600;
  line-height: 1.5;
}

.history-time {
  font-size: 24rpx;
  color: #5c5855;
  text-align: right;
  font-weight: 400;
}
