.container { padding: 40rpx 40rpx calc(48rpx + env(safe-area-inset-bottom)); }
.page-title { margin-bottom: 40rpx; text-align: left; }
.page-title > text { display: block; font-size: 52rpx; font-weight: 800; }
.page-title .page-eyebrow { margin-bottom: 14rpx; color: #7db7ff; font-size: 20rpx; letter-spacing: 4rpx; }
.page-title .page-subtitle { margin-top: 14rpx; color: #9ca9bd; font-size: 25rpx; font-weight: 400; }
.translate-modes { display: flex; margin-bottom: 32rpx; padding: 8rpx; border: 1rpx solid #2b3a52; border-radius: 999rpx; background: #152238; }
.mode-btn { flex: 1; min-height: 80rpx; margin: 0; padding: 16rpx; border: 0; border-radius: 999rpx; background: transparent; color: #9ca9bd; font-size: 26rpx; line-height: 1.4; transition: background .2s ease, color .2s ease; }
.mode-btn::after { border: none; }
.mode-btn.active { background: #ff7a59; color: #172235; font-weight: 700; box-shadow: 0 6rpx 16rpx rgba(255,122,89,.2); }
.translate-area { margin-bottom: 32rpx; }
.input-section { margin-bottom: 24rpx; padding: 28rpx; border: 1rpx solid #3b4e6b; border-radius: 8rpx 28rpx 28rpx 28rpx; background: #1a2940; }
.section-title { display: block; margin-bottom: 20rpx; color: #fff8ed; font-size: 28rpx; font-weight: 700; }
.input-area { width: 100%; height: 220rpx; padding: 20rpx; border-color: #2b3a52; background: #152238; }
.input-area-focus { border-color: #7db7ff; }
.char-count { display: block; margin-top: 12rpx; color: #9ca9bd; font-size: 22rpx; text-align: right; }
.translate-btn { width: 100%; margin: 0 0 32rpx; }
.result-card { margin-bottom: 24rpx; padding: 28rpx; border: 1rpx solid #3b4e6b; border-radius: 8rpx 30rpx 30rpx 30rpx; background: #1a2940; box-shadow: 0 12rpx 30rpx rgba(3,9,19,.2); }
.section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; padding-bottom: 18rpx; border-bottom: 1rpx solid #2b3a52; }
.section-header .section-title { margin: 0; }
.result-content { padding: 24rpx; border: 1rpx solid rgba(255,122,89,.28); border-radius: 20rpx 20rpx 6rpx 20rpx; background: rgba(255,122,89,.08); }
.result-text { color: #fff8ed; font-size: 30rpx; line-height: 1.65; overflow-wrap: anywhere; }
.result-highlight { padding: 2rpx 4rpx; border-radius: 6rpx; background: #ff7a59; color: #172235; font-weight: 700; }
.alternatives { margin-top: 24rpx; }
.alternative-label { display: block; margin-bottom: 14rpx; color: #9ca9bd; font-size: 23rpx; }
.alternative-list { display: flex; flex-wrap: wrap; gap: 14rpx; }
.alternative-btn { min-height: 64rpx; margin: 0; padding: 10rpx 22rpx; border: 1rpx solid #405573; border-radius: 999rpx; background: #223451; color: #b9d6ff; font-size: 24rpx; line-height: 1.4; }
.alternative-btn::after { border: none; }
.copy-btn, .clear-btn { min-height: 64rpx; margin: 0; padding: 10rpx 20rpx; border: 1rpx solid #405573; border-radius: 18rpx; background: #223451; color: #b9d6ff; font-size: 22rpx; line-height: 1.4; }
.copy-btn::after, .clear-btn::after { border: none; }
.clear-btn { background: transparent; color: #9ca9bd; border-color: #2b3a52; }
.history-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.history-title { font-size: 32rpx; font-weight: 800; }
.history-list { overflow: hidden; border: 1rpx solid #2b3a52; border-radius: 24rpx; background: #172438; }
.history-item { padding: 26rpx 28rpx; transition: background .2s ease; }
.history-item:not(:last-child) { border-bottom: 1rpx solid #2b3a52; }
.history-item:active { background: #223451; }
.original { display: block; margin-bottom: 10rpx; color: #d9e2ee; font-size: 27rpx; line-height: 1.5; }
.arrow { display: block; margin: 8rpx 0; color: #7db7ff; font-size: 22rpx; }
.translated { display: block; color: #ff9a7a; font-size: 27rpx; font-weight: 600; line-height: 1.5; }
.history-time { display: block; margin-top: 12rpx; color: #9ca9bd; font-size: 20rpx; text-align: right; }
.no-match-tip { margin-top: 16rpx; padding: 20rpx; border: 1rpx solid #2b3a52; border-radius: 18rpx; background: #172438; color: #9ca9bd; font-size: 23rpx; text-align: center; }
