.container { padding: 32rpx 40rpx calc(48rpx + env(safe-area-inset-bottom)); }
.search-header { margin-bottom: 36rpx; }
.search-box { display: flex; align-items: center; padding: 16rpx 18rpx 16rpx 24rpx; border: 1rpx solid #3b4e6b; border-radius: 26rpx; background: #1a2940; transition: border-color .2s ease, box-shadow .2s ease; }
.search-box-focus { border-color: #7db7ff; box-shadow: 0 0 0 6rpx rgba(125,183,255,.08); }
.search-icon { margin-right: 14rpx; color: #7db7ff; font-size: 32rpx; }
.search-input { flex: 1; height: 64rpx; color: #fff8ed; font-size: 28rpx; }
.clear-btn { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; margin-left: 12rpx; border-radius: 50%; background: #2b3a52; }
.clear-icon { color: #d9e2ee; font-size: 30rpx; }
.searching { padding: 100rpx 0; color: #9ca9bd; text-align: center; }
.results-header { margin-bottom: 22rpx; }
.results-count { color: #9ca9bd; font-size: 23rpx; }
.no-results { padding: 100rpx 32rpx; border: 1rpx solid #2b3a52; border-radius: 8rpx 28rpx 28rpx 28rpx; background: #172438; text-align: center; }
.no-results-icon { display: block; margin-bottom: 24rpx; font-size: 76rpx; filter: grayscale(.4); }
.no-results-text { display: block; margin-bottom: 12rpx; font-size: 30rpx; font-weight: 700; }
.no-results-tip { color: #9ca9bd; font-size: 24rpx; }
.word-list { display: flex; flex-direction: column; gap: 22rpx; }
.word-item { position: relative; padding: 30rpx; overflow: hidden; border: 1rpx solid #2b3a52; border-radius: 8rpx 28rpx 28rpx 28rpx; background: #1a2940; transition: transform .2s ease, border-color .2s ease; }
.word-item:nth-child(3n+2) { border-radius: 28rpx 8rpx 28rpx 28rpx; }
.word-item:active { transform: scale(.98); border-color: #ff7a59; }
.word-header { display: flex; align-items: flex-start; gap: 14rpx; margin-bottom: 14rpx; }
.word-title { flex: 1; min-width: 0; color: #ff9a7a; font-size: 36rpx; font-weight: 800; overflow-wrap: anywhere; }
.category-label { flex-shrink: 0; padding: 5rpx 14rpx; border: 1rpx solid rgba(125,183,255,.3); border-radius: 999rpx; background: rgba(125,183,255,.08); color: #9cc6ff; font-size: 20rpx; }
.word-meaning { display: block; margin-bottom: 18rpx; color: #d9e2ee; font-size: 27rpx; line-height: 1.65; }
.highlight { padding: 0 4rpx; border-radius: 5rpx; background: #7db7ff; color: #172235; }
.word-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx; }
.tag-item, .tag-chip { display: inline-flex; align-items: center; box-sizing: border-box; min-height: 56rpx; padding: 8rpx 18rpx; border: 1rpx solid #405573; border-radius: 999rpx; background: #223451; color: #b9d6ff; font-size: 23rpx; }
.tag-item:active, .tag-chip:active { background: #2b3a52; }
.word-actions { display: flex; justify-content: flex-end; }
.action-btn { margin: 0; padding: 0; border: 0; background: transparent; line-height: 1.4; }
.action-btn::after { border: none; }
.translate-btn { min-height: 64rpx; padding: 10rpx 26rpx; border: 1rpx solid rgba(255,122,89,.4); border-radius: 18rpx; background: rgba(255,122,89,.1); color: #ff9a7a; font-size: 23rpx; box-shadow: none; }
.search-home { display: flex; flex-direction: column; gap: 28rpx; }
.history-section, .tags-section { padding: 28rpx; border: 1rpx solid #2b3a52; border-radius: 8rpx 28rpx 28rpx 28rpx; background: #172438; }
.section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; }
.section-title { font-size: 30rpx; font-weight: 800; }
.clear-history-btn { min-height: 60rpx; margin: 0; padding: 8rpx 18rpx; border: 1rpx solid #2b3a52; border-radius: 16rpx; background: transparent; color: #9ca9bd; font-size: 22rpx; line-height: 1.4; }
.clear-history-btn::after { border: none; }
.history-list { display: flex; flex-direction: column; gap: 12rpx; }
.history-item { display: flex; align-items: center; padding: 20rpx; border-radius: 16rpx; background: #223451; }
.history-icon { margin-right: 14rpx; color: #7db7ff; }
.history-text { color: #fff8ed; font-size: 27rpx; }
.tags-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.tag-chip { min-height: 64rpx; padding: 12rpx 24rpx; color: #ff9a7a; border-color: rgba(255,122,89,.3); background: rgba(255,122,89,.08); }
.tag-text { color: inherit; }
.load-more-btn { width: calc(100% - 80rpx); margin: 32rpx 40rpx 0; }
@media (max-width: 375px) {
  .word-header { flex-direction: column; gap: 10rpx; }
  .category-label { align-self: flex-start; }
}
