<view class="container safe-bottom">
  <!-- 搜索框 -->
  <view class="search-header">
    <view class="search-box {{searchKeyword ? 'search-box-focus' : ''}}">
      <text class="search-icon">🔍</text>
      <input 
        class="search-input"
        placeholder="搜索黑话、含义或标签"
        placeholder-style="color: #b8b2aa"
        value="{{searchKeyword}}"
        bindinput="onInput"
        bindconfirm="onSearch"
        focus="{{true}}"
      />
      <view wx:if="{{searchKeyword}}" class="clear-btn" bindtap="clearSearch" aria-role="button" aria-label="清空搜索内容">
        <text class="clear-icon">×</text>
      </view>
    </view>
  </view>

  <!-- 搜索中状态 -->
  <view class="searching" wx:if="{{searching}}">
    <text class="searching-text">搜索中...</text>
  </view>

  <!-- 搜索结果 -->
  <view class="search-results" wx:if="{{!showHistory && !searching}}">
    <view class="results-header" wx:if="{{searchResults.length > 0}}">
      <text class="results-count">找到 {{resultTotal}} 个结果</text>
    </view>
    
    <view class="no-results" wx:if="{{searchResults.length === 0}}">
      <text class="no-results-icon">🔍</text>
      <text class="no-results-text">没有找到相关内容</text>
      <text class="no-results-tip">试试其他关键词或标签</text>
    </view>

    <view class="word-list">
      <view 
        class="word-item {{index < 8 ? 'fade-in-up' : ''}}"
        wx:for="{{searchResults}}"
        wx:key="id"
        bindtap="goToWordDetail"
        data-id="{{item.id}}"
        aria-role="button"
        aria-label="{{item.word}}，查看词条详情"
        style="{{index < 8 ? 'animation-delay: ' + (index * 0.035) + 's' : ''}}"
      >
        <view class="word-header">
          <text class="word-title">
            <text wx:for="{{item.wordSegs}}" wx:for-item="seg" wx:for-index="segIdx" wx:key="segIdx" class="{{seg.highlight ? 'highlight' : ''}}">{{seg.text}}</text>
          </text>
          <text class="category-label">{{item.categoryName}}</text>
        </view>
        <text class="word-meaning">
          <text wx:for="{{item.meaningSegs}}" wx:for-item="seg" wx:for-index="segIdx" wx:key="segIdx" class="{{seg.highlight ? 'highlight' : ''}}">{{seg.text}}</text>
        </text>
        
        <view class="word-tags">
          <text 
            class="tag-item" 
            wx:for="{{item.tags}}" 
            wx:for-item="tag"
            wx:key="*this"
            catchtap="searchByTag"
            data-tag="{{tag}}"
            aria-role="button"
            aria-label="搜索标签 {{tag}}"
          >{{tag}}</text>
        </view>
        
        <view class="word-actions">
          <button 
            class="action-btn translate-btn" 
            data-word="{{item.word}}"
            catchtap="goToTranslate"
            size="mini"
          >翻译</button>
        </view>
      </view>
    </view>
    <button class="load-more-btn" wx:if="{{hasMore}}" bindtap="loadMore">加载更多（已显示 {{searchResults.length}}/{{resultTotal}}）</button>
  </view>

  <!-- 搜索历史和热门标签 -->
  <view class="search-home" wx:if="{{showHistory}}">
    <!-- 搜索历史 -->
    <view class="history-section" wx:if="{{searchHistory.length > 0}}">
      <view class="section-header">
        <text class="section-title">搜索历史</text>
        <button class="clear-history-btn" bindtap="clearHistory" size="mini">清空</button>
      </view>
      <view class="history-list">
        <view 
          class="history-item" 
          wx:for="{{searchHistory}}" 
          wx:key="*this"
          bindtap="searchFromHistory"
          data-keyword="{{item}}"
        >
          <text class="history-icon">🕐</text>
          <text class="history-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 热门标签 -->
    <view class="tags-section">
      <view class="section-header">
        <text class="section-title">热门标签</text>
      </view>
      <view class="tags-grid">
        <view 
          class="tag-chip" 
          wx:for="{{popularTags}}" 
          wx:key="*this"
          bindtap="searchByTag"
          data-tag="{{item}}"
        >
          <text class="tag-text">{{item}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
