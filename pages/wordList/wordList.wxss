.container { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.page-header { padding: 64rpx 40rpx 44rpx; }
.header-content { display: flex; flex-direction: column; align-items: flex-start; }
.page-eyebrow { margin-bottom: 14rpx; color: #7db7ff; font-size: 20rpx; font-weight: 700; letter-spacing: 4rpx; }
.page-title { font-size: 54rpx; font-weight: 800; }
.word-count { margin-top: 14rpx; color: #9ca9bd; font-size: 24rpx; }
.words-list { display: flex; flex-direction: column; gap: 22rpx; padding: 0 40rpx; }
.word-card { position: relative; padding: 30rpx; overflow: hidden; border: 1rpx solid #2b3a52; border-radius: 8rpx 28rpx 28rpx 28rpx; background: #1a2940; transition: transform .2s ease, border-color .2s ease; }
.word-card:nth-child(3n+2) { border-radius: 28rpx 8rpx 28rpx 28rpx; }
.word-card:active { transform: scale(.98); border-color: #ff7a59; }
.word-header { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid #2b3a52; }
.word-title { flex: 1; min-width: 0; color: #ff9a7a; font-size: 36rpx; font-weight: 800; overflow-wrap: anywhere; }
.word-meaning { flex-shrink: 0; max-width: 58%; overflow: hidden; padding: 7rpx 14rpx; border: 1rpx solid #405573; border-radius: 999rpx; background: #223451; color: #b9d6ff; font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.word-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx; }
.word-tag { padding: 6rpx 14rpx; border: 1rpx solid #2b3a52; border-radius: 999rpx; background: #172438; color: #9ca9bd; font-size: 21rpx; }
.word-example { margin-top: 18rpx; padding-top: 20rpx; border-top: 1rpx dashed #3b4e6b; }
.example-label { display: flex; align-items: center; margin-bottom: 12rpx; }
.label-icon { margin-right: 8rpx; color: #7db7ff; }
.label-text { color: #9ca9bd; font-size: 22rpx; }
.example-text { color: #d9e2ee; font-size: 26rpx; line-height: 1.65; }
.bottom-tip { padding: 40rpx; text-align: center; }
.tip-text { color: #9ca9bd; font-size: 22rpx; }
.empty-block { margin: 40rpx; padding: 90rpx 32rpx; border: 1rpx dashed #3b4e6b; border-radius: 28rpx; color: #9ca9bd; font-size: 27rpx; text-align: center; }
.load-more-btn { width: calc(100% - 80rpx); margin: 32rpx 40rpx 0; }
@media (max-width: 375px) {
  .word-header { flex-direction: column; align-items: flex-start; }
  .word-meaning { max-width: 100%; white-space: normal; }
}
