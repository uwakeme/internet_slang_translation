/* ========== 词语列表页 - 精致暖色深色主题 ========== */

.container {
  min-height: 100vh;
  padding: 0 0 48rpx 0;
  position: relative;
}

.page-header {
  position: relative;
  padding: 72rpx 40rpx 48rpx;
  text-align: center;
  z-index: 1;
}

.header-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.page-title {
  font-size: 52rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #f5a623, #ff6b6b);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  letter-spacing: 2rpx;
}

.word-count {
  font-size: 26rpx;
  color: #9a9590;
  font-weight: 300;
  letter-spacing: 1rpx;
}

.words-list {
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.word-card {
  background: linear-gradient(180deg, rgba(38, 41, 54, 0.95) 0%, rgba(22, 24, 32, 0.95) 100%);
  backdrop-filter: blur(32rpx);
  -webkit-backdrop-filter: blur(32rpx);
  border-radius: 24rpx;
  padding: 34rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.4), inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
  opacity: 0;
  animation-fill-mode: forwards;
}

.word-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.18), transparent);
}

.word-card:active {
  transform: scale(0.97);
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.45), inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
}

.word-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  gap: 16rpx;
}

.word-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #f5a623;
  flex-shrink: 0;
}

.word-meaning {
  background: rgba(245, 166, 35, 0.08);
  color: #f5a623;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
  border: 1rpx solid rgba(245, 166, 35, 0.3);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
  flex-shrink: 0;
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.word-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.word-tag {
  background: rgba(255, 255, 255, 0.04);
  color: #9a9590;
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
}

.word-example {
  margin-top: 16rpx;
}

.example-label {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.label-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
  color: #f5a623;
}

.label-text {
  font-size: 24rpx;
  color: #5c5855;
  font-weight: 500;
}

.example-text {
  font-size: 26rpx;
  color: #9a9590;
  line-height: 1.6;
}

.bottom-tip {
  text-align: center;
  padding: 48rpx 40rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #5c5855;
}

/* 淡入动画 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.fade-in-up {
  animation: fadeInUp 0.4s ease-out forwards;
  opacity: 0;
}
