<view class="container safe-bottom">
  <view class="page-header">
    <view class="header-content">
      <text class="page-title">{{categoryName}}</text>
      <text class="word-count">共{{total}}个词汇</text>
    </view>
  </view>

  <view class="empty-block" wx:if="{{words.length === 0}}">
    <text class="empty-text">{{isFavorites ? '还没有收藏，去词条详情点 ☆ 收藏吧' : '该分类暂无词汇'}}</text>
  </view>

  <view class="words-list" wx:else>
    <view
      class="word-card {{index < 8 ? 'fade-in-up' : ''}}"
      wx:for="{{words}}"
      wx:key="id"
      bindtap="goToWordDetail"
      data-id="{{item.id}}"
      aria-role="button"
      aria-label="{{item.word}}，查看词条详情"
      style="{{index < 8 ? 'animation-delay: ' + (index * 0.035) + 's' : ''}}"
    >
      <view class="word-header">
        <text class="word-title">{{item.word}}</text>
        <text class="word-meaning">{{item.meaning}}</text>
      </view>

      <view class="word-tags" wx:if="{{item.tags && item.tags.length > 0}}">
        <text class="word-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
      </view>
      
      <view class="word-example" wx:if="{{item.example}}">
        <view class="example-label">
          <text class="label-icon">💡</text>
          <text class="label-text">使用示例</text>
        </view>
        <text class="example-text">{{item.example}}</text>
      </view>
    </view>
  </view>

  <button class="load-more-btn" wx:if="{{hasMore}}" bindtap="loadMore">加载更多（已显示 {{words.length}}/{{total}}）</button>

  <view class="bottom-tip" wx:if="{{words.length > 0}}">
    <text class="tip-text">💡 点击任意词汇可查看详细信息</text>
  </view>
</view>
